{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "wezterm-agent-state", "args": ["running"] }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "wezterm-agent-state", "args": ["running"] }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "wezterm-agent-state", "args": ["attention"] }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "wezterm-agent-state", "args": ["completed"] }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "wezterm-agent-state", "args": ["failed"] }] }
    ]
  }
}
